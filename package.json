{
  "name": "react-form-wizard-component",
  "version": "2.0.0",
  "private": false,
  "author": "Parsa Jiravand",
  "license": "MIT",
  "description": "Accessible multi-step form wizard for React 17, 18 and 19. Zero dependencies, TypeScript-first, modern styling with automatic dark mode, styled or headless, with per-step validation for Zod and react-hook-form.",
  "homepage": "https://github.com/parsajiravand/react-form-wizard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parsajiravand/react-form-wizard.git"
  },
  "bugs": {
    "url": "https://github.com/parsajiravand/react-form-wizard/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/react-form-wizard-component.cjs",
  "module": "./dist/react-form-wizard-component.es.js",
  "types": "./dist/types/main.d.ts",
  "unpkg": "./dist/react-form-wizard-component.umd.js",
  "jsdelivr": "./dist/react-form-wizard-component.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/main.d.ts",
        "default": "./dist/react-form-wizard-component.es.js"
      },
      "require": {
        "types": "./dist/types-cjs/main.d.cts",
        "default": "./dist/react-form-wizard-component.cjs"
      }
    },
    "./styles.css": "./dist/react-form-wizard-component.css",
    "./dist/style.css": "./dist/style.css",
    "./dist/react-form-wizard-component.css": "./dist/react-form-wizard-component.css",
    "./package.json": "./package.json",
    "./legacy.css": "./dist/legacy.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vite build && node scripts/build-css.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json && node scripts/build-types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:exports": "attw --pack . --exclude-entrypoints styles.css legacy.css dist/style.css dist/react-form-wizard-component.css",
    "check:publish": "publint",
    "size": "size-limit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:publish && npm run check:exports",
    "prepublishOnly": "npm run verify",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "size-limit": [
    {
      "name": "FormWizard (ESM, gzip)",
      "path": "dist/react-form-wizard-component.es.js",
      "limit": "6.5 kB",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "Stylesheet (gzip)",
      "path": "dist/react-form-wizard-component.css",
      "limit": "2.5 kB"
    },
    {
      "name": "Legacy skin (gzip, opt-in)",
      "path": "dist/legacy.css",
      "limit": "3 kB"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "publint": "^0.3.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^11.1.6",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "react",
    "form",
    "wizard",
    "form-wizard",
    "stepper",
    "multi-step",
    "multi-step-form",
    "step-form",
    "step-by-step",
    "guided-form",
    "onboarding",
    "checkout",
    "react-form",
    "form-validation",
    "form-builder",
    "wizard-component",
    "wizard-form",
    "headless",
    "accessible",
    "a11y",
    "typescript",
    "react-component",
    "react-hook-form",
    "zod",
    "nextjs",
    "app-router",
    "react17",
    "react18",
    "react19"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
